{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Host filtering: MUST be set per deployment to the API's real public host(s), e.g.
  // "api.example.com". Left empty here on purpose so a deploy that forgets to override it filters
  // everything rather than shipping the wide-open "*" default (which is set only in Development).
  "AllowedHosts": "",
  "Game": {
    "DefaultRule": "B3/S23",
    "BroadcastIntervalMs": 10,
    "UniverseAxisSize": "uint64" // uint8, uint16, uint32
  },
  // CORS origins are intentionally empty in the base config: each deployment must supply its client's
  // real origin(s) via appsettings.{Environment}.json (or env vars). An empty list fails startup, and
  // CorsOptionsValidator additionally rejects localhost origins outside Development.
  "Cors": {
    "AllowedOrigins": []
  }
}
