<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    The backend-independent heart of the frontend integration seam (wayfinder #23).
    Deliberately has NO Blazor / SignalR / HttpClient dependency: the model, the
    Result monad, the seam interfaces, and GameStore's reconcile/resync logic all
    run as plain C# so they stay unit-testable off the Wasm host. The real HTTP /
    SignalR / localStorage implementations (#24, #25) add their package references
    to this project later.
  -->

</Project>
