@using GameOfLife.WebClient.Communication.Seeding
@inject IJSRuntime JS
@implements IAsyncDisposable

@* The seed-authoring surface (wayfinder #16, built into the create page #18 — its sole consumer).
   Two-column layout: a fixed-width control column on the left holds everything — the host page's chrome
   (back link + title, via <Header>), the create action + advanced settings (via <Settings>), and the
   Board / Presets / Saved seed / Import tools — while the painting canvas sits to its right and rises to
   the top-left of the row (nothing above it), growing to fill the remaining space. seedCanvas.js derives
   the cell size from that box, so the fixed 100×100 grid just gets bigger, easier-to-click cells. The
   board (SeedBoard) is authoritative C#; seedCanvas.js only renders it and reports strokes. The parent
   (Admin) reads GetSeedBase64() on create. *@
<div class="seed-editor">
    <div class="seed-body">
        <div class="seed-controls">
            @* Host-supplied page chrome (back link + title) sits atop the column so the grid beside it can
               rise to the top of the row — nothing above it eats vertical space. *@
            @if (Header is not null)
            {
                <div class="seed-header">@Header</div>
            }

            <div class="seed-controls-head">
                <span class="seed-hint"><strong>Left-click</strong> draw · <strong>Right-click</strong> erase · drag to sweep</span>
                <span class="seed-count">@_board.AliveCount live</span>
            </div>

            @* The create action and its advanced knobs, supplied by the host page so this component stays a
               pure seed editor while still presenting them inside the one control column. *@
            @if (Settings is not null)
            {
                <div class="seed-group">@Settings</div>
            }

            <div class="seed-group">
                <span class="seed-group-title">Board</span>
                <div class="seed-group-body seed-group-body--fill">
                    <button type="button" class="seed-tool" @onclick="Clear">Clear</button>
                    <button type="button" class="seed-tool" @onclick="Invert">Invert</button>
                    <button type="button" class="seed-tool" @onclick="Randomize">Random</button>
                </div>
            </div>

            @* One-click figure placement: each stamps its shape centred on the torus. *@
            <div class="seed-group">
                <span class="seed-group-title">Presets</span>
                <div class="seed-group-body">
                    @foreach (var p in SeedPatterns.All)
                    {
                        <button type="button" class="seed-tool" title="Place @p.Name (@p.Category) at the centre" @onclick="() => StampPreset(p)">@p.Name</button>
                    }
                </div>
            </div>

            @* Persist the current drawing to this browser's local storage and restore it later — a quick
               scratch slot that survives reloads without touching the RLE textbox below. *@
            <div class="seed-group">
                <span class="seed-group-title">Saved seed</span>
                <div class="seed-group-body seed-group-body--fill">
                    <button type="button" class="seed-tool" @onclick="SaveSeed">Save seed</button>
                    <button type="button" class="seed-tool" disabled="@(!_hasSaved)" @onclick="LoadSeed">Load saved seed</button>
                </div>
                @if (_seedMsg is not null)
                {
                    <span class="seed-note">@_seedMsg</span>
                }
            </div>

            @* Host-supplied secondary knobs, parked at the very bottom of the column below the everyday tools. *@
            @if (Advanced is not null)
            {
                <div class="seed-group">@Advanced</div>
            }
        </div>

        <canvas @ref="_canvas" class="seed-canvas"></canvas>
    </div>
</div>

@code {
    // The on-screen cell size is no longer a fixed C# constant: the canvas is sized by CSS (a
    // viewport-relative square) and seedCanvas.js derives px = boxWidth / 100 so the whole grid always
    // fits with cells as large as the space allows.
    private readonly SeedBoard _board = new();
    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SeedEditor>? _self;
    private int _id;
    private bool _ready;

    // A single scratch slot in the browser's localStorage: save stores the current board as base64
    // (the same packing POST /game consumes), load restores it. Survives reloads; per-browser, not shared.
    private const string SavedSeedKey = "gol.seed";
    private bool _hasSaved;
    private string? _seedMsg;

    /// <summary>Raised after any board change so the parent can re-evaluate its Create affordance.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>
    /// Host-supplied page chrome (back link + title) rendered at the very top of the control column, so the
    /// canvas beside it can rise to the top of the row instead of sitting under a page header.
    /// </summary>
    [Parameter] public RenderFragment? Header { get; set; }

    /// <summary>
    /// Host-supplied primary action (the create button + its messages) rendered near the top of the control
    /// column, so the page's primary action sits with the editing tools without this component owning it.
    /// </summary>
    [Parameter] public RenderFragment? Settings { get; set; }

    /// <summary>
    /// Host-supplied secondary knobs (advanced settings) parked at the bottom of the control column, below
    /// the everyday editing tools.
    /// </summary>
    [Parameter] public RenderFragment? Advanced { get; set; }

    /// <summary>The current alive-cell count (for the parent's summary).</summary>
    public int AliveCount => _board.AliveCount;

    /// <summary>The seed as the backend wants it — base64 of the 1250-byte packing.</summary>
    public string GetSeedBase64() => _board.ToBase64();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Absolute path (not "./js/…"): the .NET static-asset importmap remaps relative specifiers to a
        // fingerprinted alias the WebAssembly DevServer doesn't serve. Mirrors GameViewport (#15).
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/seedCanvas.js");
        _self = DotNetObjectReference.Create(this);
        _id = await _module.InvokeAsync<int>("create", _canvas, _self, SeedBoard.Size);
        _ready = true;

        // Reflect any previously saved seed so "Load saved seed" starts enabled when there's one to load.
        var existing = await JS.InvokeAsync<string?>("localStorage.getItem", SavedSeedKey);
        _hasSaved = !string.IsNullOrEmpty(existing);
        StateHasChanged();
    }

    [JSInvokable]
    public void OnPaint(int x, int y, bool alive)
    {
        // Authoritative update; the canvas already drew it optimistically, so no re-render here.
        _board.Set(x, y, alive);
    }

    [JSInvokable]
    public async Task OnStrokeEnd()
    {
        await NotifyChanged();
    }

    // One click, one placement: each preset button clears the current seed then stamps its figure centred
    // on the torus (no select-then-place two-step), so each press starts from a blank grid. Mirrors the
    // button library the create form (#18) now shows.
    private Task StampPreset(SeedPattern pattern)
    {
        _board.Clear();
        _board.StampCentered(pattern);
        return PushAsync();
    }

    private Task Clear()
    {
        _board.Clear();
        return PushAsync();
    }

    private Task Invert()
    {
        _board.Invert();
        return PushAsync();
    }

    private Task Randomize()
    {
        _board.Randomize(Random.Shared, 0.18);
        return PushAsync();
    }

    // Persist the current board to local storage. The board itself doesn't change, so no canvas re-render
    // or parent notification is needed — just enable the Load button and confirm.
    private async Task SaveSeed()
    {
        await JS.InvokeVoidAsync("localStorage.setItem", SavedSeedKey, _board.ToBase64());
        _hasSaved = true;
        _seedMsg = $"Saved {_board.AliveCount} live cell{(_board.AliveCount == 1 ? "" : "s")} to this browser.";
        StateHasChanged();
    }

    private async Task LoadSeed()
    {
        var stored = await JS.InvokeAsync<string?>("localStorage.getItem", SavedSeedKey);
        if (!_board.TryLoadBase64(stored))
        {
            // Nothing usable in the slot (cleared elsewhere, or corrupt): leave the board untouched.
            _hasSaved = false;
            _seedMsg = "No saved seed to load.";
            StateHasChanged();
            return;
        }

        _seedMsg = "Loaded the saved seed.";
        await PushAsync();
    }

    // Push the authoritative board to the canvas after a bulk op, then notify the parent.
    private async Task PushAsync()
    {
        if (_ready) await _module!.InvokeVoidAsync("render", _id, _board.ToPackedBytes());
        await NotifyChanged();
    }

    private async Task NotifyChanged()
    {
        await InvokeAsync(StateHasChanged);
        if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose", _id); } catch { /* teardown races on unload */ }
            try { await _module.DisposeAsync(); } catch { }
        }
        _self?.Dispose();
    }
}
