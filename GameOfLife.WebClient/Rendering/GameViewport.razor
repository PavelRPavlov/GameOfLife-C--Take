@using GameOfLife.Core
@inject GameStore Store
@inject IJSRuntime JS
@implements IAsyncDisposable

@* The reusable grid viewport (wayfinder #15). A read-only window onto the 2^64 torus that both the
   admin (#18) and observer (#19) pages embed — it renders the live set and repaints on updates, and
   owns no game controls. It is a thin mirror of GameStore onto the gameViewport.js engine (rendering
   approach fixed by research #11; viewport model prototyped at /proto/viewport and signed off):

     - GameStore.SnapshotApplied  -> engine.snapshot(...)   full repaint (and fit-once on the first)
     - GameStore.DeltaApplied     -> engine.delta(...)      incremental births/deaths

   All cell state and the pan/zoom/rAF paint live JS-side; this component only marshals cells (ulong
   coords as decimal-string "x,y", the wire's own representation) across the interop boundary. *@

<canvas @ref="_canvas" class="game-viewport"></canvas>

@code {
    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private int _id;
    private bool _ready;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Absolute path, not "./js/…": the .NET static-asset importmap remaps the relative specifier to
        // a fingerprinted alias the WebAssembly DevServer doesn't serve. The absolute path loads the
        // physical module directly. (See the same note in the #15 prototype.)
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/gameViewport.js");
        _id = await _module.InvokeAsync<int>("create", _canvas);
        _ready = true;

        // Subscribe first, then seed from the current live set: if a delta fires before the seed it is
        // applied to the (empty) engine set and then overwritten by the snapshot — never lost. There is
        // no await between subscribe and seed, so on Blazor's single thread nothing interleaves.
        Store.SnapshotApplied += OnSnapshot;
        Store.DeltaApplied += OnDelta;
        PushSnapshot(Store.LiveCells, Store.Generation);
    }

    private void OnSnapshot(Snapshot s) => PushSnapshot(s.Cells, s.Gen);

    private void OnDelta(Delta d)
    {
        if (!_ready) return;
        Invoke("delta", _id, Keys(d.Births), Keys(d.Deaths), d.ToGen);
    }

    private void PushSnapshot(IReadOnlyCollection<Cell> cells, long gen)
    {
        if (!_ready) return;
        Invoke("snapshot", _id, Keys(cells), gen);
    }

    // Fire-and-forget interop. On Blazor's single Wasm thread the JS engine functions (delta/snapshot) are
    // synchronous, so the call marshals and runs to completion before the returned task settles — successive
    // pushes therefore stay in order without an explicit queue (the ordering the delta storm would threaten
    // only exists across threads or async JS, neither of which applies here). The task is still observed so a
    // post-disposal ObjectDisposedException (a teardown race) is swallowed intentionally and any other fault
    // surfaces to the console instead of becoming an unobserved fault.
    private void Invoke(string method, params object?[] args) =>
        _module!.InvokeVoidAsync(method, args).FireAndForget($"GameViewport.{method}");

    private static string[] Keys(IReadOnlyCollection<Cell> cells)
    {
        // Right-sized from the known Count (Delta/Snapshot expose IReadOnlyList) — no intermediate List + copy.
        var keys = new string[cells.Count];
        var i = 0;
        foreach (var c in cells) keys[i++] = $"{c.X},{c.Y}";
        return keys;
    }

    public async ValueTask DisposeAsync()
    {
        Store.SnapshotApplied -= OnSnapshot;
        Store.DeltaApplied -= OnDelta;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose", _id); } catch { /* teardown races on unload */ }
            try { await _module.DisposeAsync(); } catch { }
        }
    }
}
